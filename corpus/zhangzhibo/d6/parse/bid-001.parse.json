            ]
          },
          {
            "block_id": "dc1c912b9_p002_b00001",
            "page": 2,
            "role": "TITLE",
            "text": "1.截至本公告披露之日，公司尚未取得该项目的中标通知书，公司能否收到",
            "text_raw": "1.截至本公告披露之日，公司尚未取得该项目的中标通知书，公司能否收到",
            "region": [
              114.0,
