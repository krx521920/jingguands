          "doc_id": "dfc6c3d84",
          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "司发出的中标通知书，上海同济建设有限公司与上海天华建筑设计有限公司联合",
          "text_raw": "司发出的中标通知书，上海同济建设有限公司与上海天华建筑设计有限公司联合",
          "region": [
            90.0,
            314.57,
