          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "公司全资子公司上海同济建设有限公司收到上海金滨海房地产开发有限公",
          "text_raw": "公司全资子公司上海同济建设有限公司收到上海金滨海房地产开发有限公",
          "region": [
