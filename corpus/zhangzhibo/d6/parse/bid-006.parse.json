            326.57
          ],
          "table_ref": null,
          "font_size": 12.0,
          "source": "TEXT_LAYER",
          "ocr_confidence": null,
          "degraded": false,
          "missing_reason": null
        },
        {
          "block_id": "dfc6c3d84_p001_b00006",
          "doc_id": "dfc6c3d84",
          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "中标金山新城JSC1-0403单元3-02-01地块商品房项目-工程总承包项目。",
          "text_raw": "中标金山新城JSC1-0403单元3-02-01地块商品房项目-工程总承包项目。",
          "region": [
            90.0,
            337.97,
            473.28,
            351.96
          ],
          "table_ref": null,
          "font_size": 12.0,
          "source": "TEXT_LAYER",
          "ocr_confidence": null,
          "degraded": false,
          "missing_reason": null
        },
        {
          "block_id": "dfc6c3d84_p001_b00007",
          "doc_id": "dfc6c3d84",
          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "该项目位于上海市金山区山阳镇，东至蒙山北路，西至卫零北路，南至南阳",
          "text_raw": "该项目位于上海市金山区山阳镇，东至蒙山北路，西至卫零北路，南至南阳",
          "region": [
            114.0,
            361.37,
            505.32,
            373.37
          ],
          "table_ref": null,
          "font_size": 12.0,
          "source": "TEXT_LAYER",
          "ocr_confidence": null,
          "degraded": false,
          "missing_reason": null
        },
        {
          "block_id": "dfc6c3d84_p001_b00008",
          "doc_id": "dfc6c3d84",
          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "湾路，北至龙山路。该项目为新建商品房项目，总建筑面积约123,234.21平方米，其中地上总建筑面积82,034.21平方米，地下总建筑面积41,200平方米；包括新建6栋7-9层洋房住宅及2栋5-7层洋房住宅、9栋叠墅住宅、20栋联排住宅、东侧住宅区设置架空车库、1栋地面配电房、室外总体、示范区、景观等。项目中标价格80,971.4662万元，其中施工价格79,821.6018万元，施工周期750天。",
          "text_raw": "湾路，北至龙山路。该项目为新建商品房项目，总建筑面积约123,234.21平方米，其中地上总建筑面积82,034.21平方米，地下总建筑面积41,200平方米；包括新建6栋7-9层洋房住宅及2栋5-7层洋房住宅、9栋叠墅住宅、20栋联排住宅、东侧住宅区设置架空车库、1栋地面配电房、室外总体、示范区、景观等。项目中标价格80,971.4662万元，其中施工价格79,821.6018万元，施工周期750天。",
          "region": [
            90.0,
            384.65,
            511.32,
            492.0
          ],
          "table_ref": null,
          "font_size": 12.0,
          "source": "TEXT_LAYER",
          "ocr_confidence": null,
          "degraded": false,
          "missing_reason": null
        },
        {
