          "missing_reason": null
        },
        {
          "block_id": "dfc6c3d84_p001_b00010",
          "doc_id": "dfc6c3d84",
          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "预计对公司当期营业收入、利润影响有限。敬请广大投资者注意投资风险。",
          "text_raw": "预计对公司当期营业收入、利润影响有限。敬请广大投资者注意投资风险。",
          "region": [
