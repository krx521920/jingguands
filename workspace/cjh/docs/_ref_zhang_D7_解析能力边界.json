  "degradation_levels": [
    {
      "level": "page",
      "trigger": "整页扫描",
      "artifact": "1 个 scan_region 块",
      "consumer": "该页字段按 unreadable"
    },
    {
      "level": "region",
      "trigger": "页内图片承载内容",
      "artifact": "该区域 1 个 scan_region 块",
      "consumer": "仅该区域内字段受影响"
    },
    {
      "level": "block",
      "trigger": "表格检出失败",
      "artifact": "内容进正文流、无 cell 块",
      "consumer": "内容可读但无列语义"
    }
  ],
  "evidence_guarantees": {
    "guaranteed": [
      "每字符恰好属于一个块",
      "text_raw 为原文子串（原始字符直拼）",
      "region 为块自身字符的外接矩形"
    ],
    "not_guaranteed": [
      "region 不含相邻块字符（外接矩形可交叠）",
      "text_raw 含换行符（不含，故跨行 quote 需空白归一）",
      "单靠 quote 唯一定位（表格内文字天然重复，必须带 block_id）"
    ]
  },
  "untested": [
    "竖排/旋转文字",
    "公式与图表内文字",
    "手写体 OCR",
    "嵌入 Office 对象",
    "页眉页脚跨页重复",
    "超 100 页文档"
  ],
  "scope_recommendation": {
