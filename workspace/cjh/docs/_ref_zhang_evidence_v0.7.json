{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finstruct/evidence.v0.7.json",
  "title": "解析出处结构 evidence/0.7",
  "description": "解析层交给下游的中间表示。v0.7 相对 v0.6：page 新增 columns（多栏页面的各栏 x 范围）。新增分栏检测：先按文本行统计找栏缝（不是按整页，否则居中标题会误判）、并排除表格内字符（否则表格的列间距会被当成栏缝），再按「整幅行分段、段内逐栏」排阅读顺序。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc",
    "pages",
    "reading_order",
    "handoff",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "evidence/0.7"
    },
    "doc": {
      "$ref": "#/$defs/Doc"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Page"
      }
    },
    "reading_order": {
      "type": "array",
      "description": "按阅读顺序排列的 block_id。必须与 pages 中出现的 block_id 集合完全一致。",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "$ref": "#/$defs/Handoff"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    }
  },
  "$defs": {
    "Region": {
      "type": "array",
      "description": "[left, top, right, bottom]，单位 PDF 点（1pt=1/72 英寸），原点页面左上角，y 轴向下为正。字段名与全队契约的 provenance.region 一致。下游换算：屏幕坐标 = region / [page.width, page.height] × 显示尺寸。",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "CoordSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "origin",
        "field",
        "order"
      ],
      "description": "坐标语义声明。全队契约的 region 未声明单位与原点，这里补齐，下游渲染高亮必须按它换算。",
      "properties": {
        "unit": {
          "const": "pdf_point"
        },
        "unit_zh": {
          "type": "string"
        },
        "origin": {
          "const": "top_left"
        },
        "origin_zh": {
          "type": "string"
        },
        "field": {
          "const": "region"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normalize_hint": {
          "type": "string"
        }
      }
    },
    "Doc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "file_id",
        "file_name",
        "file_sha256",
        "page_count",
        "parsed_at",
        "parser",
        "coord_system"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "由 file_sha256 前 8 位派生，不使用文件名 —— 防同名串证据（团队 D10）",
          "pattern": "^d[0-9a-f]{8}$"
        },
        "file_id": {
          "type": "string",
          "description": "全队契约 source.file_id 的形态",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "file_name": {
          "type": "string"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "parsed_at": {
          "type": "string",
          "description": "ISO 8601，带时区"
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "coord_system": {
          "$ref": "#/$defs/CoordSystem"
        }
      }
    },
    "Block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "doc_id",
        "page",
        "type",
        "source_type",
        "role",
        "text",
        "text_raw",
        "region",
        "source"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "description": "全局唯一且稳定；抽取层把它填进 provenance.block_id"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "const": "TEXT"
        },
        "role": {
          "enum": [
            "TITLE",
            "SECTION",
            "BODY",
            "HEADER",
            "FOOTER",
            "FOOTNOTE"
          ],
          "description": "HEADER/FOOTER 已移出正文流但保留，因为页眉页脚可能承载日期等信息"
        },
        "text": {
          "type": "string",
          "description": "拼接后的可读文本，跨行处可能补空格。供模型与展示使用，**不要**用它当 quote"
        },
        "text_raw": {
          "type": "string",
          "description": "按阅读顺序直接拼接原始字符、不插入任何字符，因此保证是原文子串。全队契约要求 provenance.quote 必须是原文子串，**quote 取这个字段**"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "font_size": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "enum": [
            "TEXT_LAYER",
            "OCR_OS",
            "VLM"
          ],
          "description": "这段文本来自哪条通道。出处可核验的前提是说清来源。"
        },
        "ocr_confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "degraded": {
          "type": "boolean"
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NOT_PARSED",
            "ILLEGIBLE",
            "DEGRADED",
            null
          ],
          "description": "缺出处的原因码。缺出处必须能被统计，不能静默。"
        },
        "table_ref": {
          "type": [
            "object",
            "null"
          ],
          "description": "表格来源定位。cell 类型的块必须给；table 类型给到行。",
          "additionalProperties": false,
          "properties": {
            "table_id": {
              "type": "string"
            },
            "cell_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "全文档唯一的单元格键（形如 \"d44e95085_p001_t001_c039\"）。分组与回溯用它。"
            },
            "row": {
              "type": [
                "integer",
                "null"
              ]
            },
            "col": {
              "type": [
                "integer",
                "null"
              ]
            },
            "cell_ref": {
              "type": [
                "string",
                "null"
              ],
              "description": "人类可读的单元格网格位置，1 基，形如 \"r2c3\"。这是要拷进全队契约 provenance.cell_ref 的值。表内唯一（已修掉合并单元格导致的撞车）。"
            },
            "rowspan": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "纵向合并跨度。"
            },
            "colspan": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "横向合并跨度。"
            },
            "header_path": {
              "type": [
                "string",
                "null"
              ],
              "description": "多层表头逐级拼出的完整列名，用 / 连接，如 \"已质押股份情况/已质押股份限售和冻结、标记数量（股）\"。表头行由「前导行中值型单元格 ≤1」判定；列数 <3 的窄表（多为\"字段名: 值\"的键值表）不判表头。抽取层必须用它区分同名子列。"
            },
            "continues": {
              "type": [
                "object",
                "null"
              ],
              "description": "本单元格是被页边界切断的碎片，内容需与上一页同列单元格拼接。consumers 必须先拼接再取值，直接用它当前文本会得到截断的值。",
              "additionalProperties": false,
              "properties": {
                "table_id": {
                  "type": "string"
                },
                "cell_ref": {
                  "type": "string"
                },
                "block_id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "doc_id": {
          "type": "string",
          "description": "块自带文档标识，使块被单独摘出时仍自足"
        },
        "source_type": {
          "enum": [
            "paragraph",
            "table",
            "cell",
            "scan_region",
            "document"
          ],
          "description": "证据结构类型，对齐评测方的 source_type 枚举。与 source（通道）是两个正交维度：同一段字可以既来自 text_layer 通道、又是 cell 结构。"
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "page",
        "region",
        "n_rows",
        "n_cols"
      ],
      "description": "表格元数据。单元格内容不在这里重复存放 —— 每个单元格以 source_type=cell 的块交付，用 table_ref 回指。",
      "properties": {
        "table_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "n_rows": {
          "type": "integer",
          "minimum": 0
        },
        "n_cols": {
          "type": "integer",
          "minimum": 0
        },
        "continued_from": {
          "type": [
            "string",
            "null"
          ],
          "description": "跨页续表（D3/D4）"
        },
        "quality": {
          "type": "object"
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "form",
        "width",
        "height",
        "blocks"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "form": {
          "enum": [
            "TEXT",
            "SCANNED",
            "MIXED"
          ],
          "description": "逐页判定，不按整份文档判定 —— 一份 PDF 常前几页有文本层、附页是扫描件"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "form_evidence": {
          "type": "object",
          "description": "形态判定的判据留痕，便于首测出错时定位是哪一项导致的",
          "properties": {
            "text_chars": {
              "type": "integer"
            },
            "text_area_ratio": {
              "type": "number"
            },
            "image_area_ratio": {
              "type": "number"
            },
            "ink_ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "rule": {
              "type": [
                "string",
                "null"
              ]
            },
            "thresholds": {
              "type": "object"
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Table"
          }
        },
        "columns": {
          "type": "array",
          "description": "多栏页面各栏的 x 范围 [[x0,x1],...]（左到右）；单栏为空数组。记下来是为了让阅读顺序可解释：为什么这块排在前面。",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "Handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_contract",
        "source",
        "provenance_from_block",
        "field_aliases",
        "blocks_path",
        "warnings"
      ],
      "description": "交给抽取层的对接块。source 可原样拷进事件信封，避免字段名靠猜。",
      "properties": {
        "target_contract": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file_id",
            "file_name",
            "file_sha256",
            "parse_meta"
          ],
          "description": "字段集严格等于全队契约的 source。含契约要求的 blocks（pages[].blocks[] 的精简副本）。",
          "properties": {
            "file_id": {
              "type": "string"
            },
            "file_name": {
              "type": "string"
            },
            "file_sha256": {
              "type": "string"
            },
            "parse_meta": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parser_version",
                "page_count"
              ],
              "description": "与全队契约的 source.parse_meta 对齐。blocks 是该契约要求的字段（D2 已加入其 schema），这里给 pages[].blocks[] 的精简副本。",
              "properties": {
                "parser_version": {
                  "type": "string"
                },
                "page_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "blocks": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "block_id",
                      "page",
                      "region",
                      "text_raw"
                    ],
                    "properties": {
                      "block_id": {
                        "type": "string"
                      },
                      "page": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "role": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "text_raw": {
                        "type": "string"
                      },
                      "region": {
                        "$ref": "#/$defs/Region"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "provenance_from_block": {
          "type": "object",
          "additionalProperties": false,
          "description": "抽取层组装 provenance 时的取法。三方字段名不同，这里一次给全。",
          "properties": {
            "block_id": {
              "type": "string"
            },
            "page": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "source_type": {
              "type": "string"
            },
            "document_id": {
              "type": "string"
            },
            "table": {
              "type": "string"
            },
            "cell": {
              "type": "string"
            }
          }
        },
        "blocks_path": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_aliases": {
          "type": "object",
          "description": "三方（解析 / 魏的抽取契约 / 宗的评测证据契约）字段名对照表，避免各自猜。",
          "additionalProperties": true
        }
      }
    },
    "Quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degraded",
        "degrade_reasons",
        "warnings"
      ],
      "properties": {
        "degraded": {
          "type": "boolean",
          "description": "有任一环节降级即为 true —— 失败即降级，绝不静默"
        },
        "degrade_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}