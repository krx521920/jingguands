{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "page",
    "source_type",
    "excerpt"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "source_type": {
      "enum": [
        "paragraph",
        "table",
        "cell",
        "scan_region",
        "document"
      ]
    },
    "excerpt": {
      "type": "string",
      "minLength": 1
    },
    "bbox": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "table": {
      "type": [
        "string",
        "null"
      ]
    },
    "cell": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
