        {
          "block_id": "daa9b83fa_p001_b00015",
          "page": 1,
          "role": "BODY",
          "text": "本项目中标金额为141,640,735元，项目履行不影响公司业务独立性，将对",
          "text_raw": "本项目中标金额为141,640,735元，项目履行不影响公司业务独立性，将对",
