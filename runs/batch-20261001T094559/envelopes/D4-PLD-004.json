          "role": "BODY",
          "text": "合计 60,108.6045 25.17% 36,531.8065 36,895.8065 61.38% 15.45% 0 0.00% 0 0.00%",
          "text_raw": "合计60,108.604525.17%36,531.806536,895.806561.38%15.45%00.00%00.00%",
