          "missing_reason": null
        },
        {
          "block_id": "d3a6938fe_p001_b00003",
          "doc_id": "d3a6938fe",
          "page": 1,
          "type": "TEXT",
          "source_type": "paragraph",
          "role": "BODY",
          "text": "述或者重大遗漏，并对其内容的真实性、准确性和完整性承担法律责任。",
          "text_raw": "述或者重大遗漏，并对其内容的真实性、准确性和完整性承担法律责任。",
          "region": [
